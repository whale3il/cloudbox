# Optional. By default the React app calls "/cloud" and the Vite dev server
# proxies it to the backend, so no configuration is needed locally.

# Backend the Vite dev server proxies to
VITE_PROXY_TARGET=http://localhost:5000

# Only set this if the API lives on another domain (e.g. a deployed backend).
# The backend must then list your site in CLIENT_ORIGIN.
# VITE_API_URL=https://your-api.example.com/cloud
