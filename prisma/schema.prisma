generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// model user{
//   id Int @id @default(autoincrement()) 
//   email String @unique
//   name String 
//   files File[]
// }

model file {
  id Int   @id @default(autoincrement()) @unique
  url String
  publicId String @unique
  filename String
  size Int
  // uploadedBy DateTime @updatedAt
  // title String? 
  createdNow DateTime @default(now())
  // users user[]
}